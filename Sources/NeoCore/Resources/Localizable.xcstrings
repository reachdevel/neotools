            "state": "translated",
            "value": "Yalnızca bildirilir (bunu başka bir program yapmalı)"
          }
        }
      }
    },
    "sweep.cat.xcode-device-support.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode device support"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode cihaz desteği"
          }
        }
      }
    },
    "sweep.cat.xcode-device-support.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "~/Library/Developer/Xcode/*DeviceSupport: symbols Xcode copied from the devices you connected."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "~/Library/Developer/Xcode/*DeviceSupport: Xcode'un bağladığınız cihazlardan kopyaladığı semboller."
          }
        }
      }
    },
    "sweep.cat.xcode-device-support.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode copies them again the next time you connect that device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode, o cihazı bir sonraki bağlayışınızda bunları yeniden kopyalar."
          }
        }
      }
    },
    "sweep.cat.downloads-installers.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old installers in Downloads"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler'deki eski yükleyiciler"
          }
        }
      }
    },
    "sweep.cat.downloads-installers.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk images, packages and archives in Downloads that are more than 30 days old."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler'deki 30 günden eski disk görüntüleri, paketler ve arşivler."
          }
        }
      }
    },
    "sweep.cat.downloads-installers.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You downloaded them yourself, so they can be downloaded again. Look before you choose: an archive may hold your own files."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onları kendiniz indirdiniz, yeniden indirilebilirler. Seçmeden önce bakın: bir arşiv kendi dosyalarınızı tutuyor olabilir."
          }
        }
      }
    },
    "sweep.cat.ios-backups.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone and iPad backups"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ve iPad yedekleri"
          }
        }
      }
    },
    "sweep.cat.ios-backups.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "~/Library/Application Support/MobileSync/Backup: one folder per device backup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "~/Library/Application Support/MobileSync/Backup: her cihaz yedeği için bir klasör."
          }
        }
      }
    },
    "sweep.cat.ios-backups.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup may be the only copy of what is on the device if it is lost. It cannot come back. Reading it needs Full Disk Access."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yedek, cihaz kaybolursa içindekilerin tek kopyası olabilir. Geri gelmez. Okunması Tam Disk Erişimi ister."
          }
        }
      }
    },
    "sweep.cat.xcode-archives.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode archives"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode arşivleri"
          }
        }
      }
    },
    "sweep.cat.xcode-archives.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "~/Library/Developer/Xcode/Archives: the builds you archived for distribution."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "~/Library/Developer/Xcode/Archives: dağıtım için arşivlediğiniz derlemeler."
          }
        }
      }
    },
    "sweep.cat.xcode-archives.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archive holds the symbols of a release you shipped; without it a crash report of that version cannot be read. It cannot come back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir arşiv, yayınladığınız sürümün sembollerini tutar; onsuz o sürümün çökme raporu okunamaz. Geri gelmez."
          }
        }
      }
    },
    "sweep.cat.ios-simulators.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulators (Xcode)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simülatörler (Xcode)"
          }
        }
      }
    },
    "sweep.cat.ios-simulators.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One folder per simulator device, with its apps and data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her simülatör cihazı için bir klasör: uygulamaları ve verisiyle."
          }
        }
      }
    },
    "sweep.cat.ios-simulators.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed with xcrun simctl delete, as Xcode does. The apps and data inside are lost; a device can be created again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode'un yaptığı gibi xcrun simctl delete ile kaldırılır. İçindeki uygulamalar ve veri kaybolur; cihaz yeniden oluşturulabilir."
          }
        }
      }
    },
    "sweep.cat.virtual-machines.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual machines"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanal makineler"
          }
        }
      }
    },
    "sweep.cat.virtual-machines.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parallels, VMware Fusion and UTM machines in the usual folders."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olağan klasörlerdeki Parallels, VMware Fusion ve UTM makineleri."
          }
        }
      }
    },
    "sweep.cat.virtual-machines.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A virtual machine is a disk of its own: everything inside is lost, and it cannot come back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanal makine kendi başına bir disktir: içindeki her şey kaybolur ve geri gelmez."
          }
        }
      }
    },
    "sweep.cat.docker.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker disk image"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker disk görüntüsü"
          }
        }
      }
    },
    "sweep.cat.docker.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything Docker keeps (images, containers, volumes) lives in one disk image."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker'ın tuttuğu her şey (imajlar, konteynerler, birimler) tek bir disk görüntüsündedir."
          }
        }
      }
    },
    "sweep.cat.docker.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "neosweep cannot look inside it and never deletes it. Run docker system prune to free the space."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "neosweep içine bakamaz ve onu asla silmez. Yer açmak için docker system prune çalıştırın."
          }
        }
      }
    },
    "sweep.ui.finderOffer": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 application needs your password. Press p to ask Finder to move it to the Trash."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld applications need your password. Press p to ask Finder to move them to the Trash."
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 uygulama parolanızı ister. Finder'dan Çöp Kutusu'na taşımasını istemek için p'ye basın."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld uygulama parolanızı ister. Finder'dan Çöp Kutusu'na taşımasını istemek için p'ye basın."
                }
              }
            }
          }
        }
      }
    },
    "sweep.ui.finderNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder:"
          }
        }
      }
    },
    "sweep.ui.finderWorking": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Asking Finder to move 1 application to the Trash (it may ask for your password)…"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Asking Finder to move %lld applications to the Trash (it may ask for your password)…"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Finder'dan 1 uygulamayı Çöp Kutusu'na taşıması isteniyor (parolanızı isteyebilir)…"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Finder'dan %lld uygulamayı Çöp Kutusu'na taşıması isteniyor (parolanızı isteyebilir)…"
                }
              }
            }
          }
        }
      }
    },
    "sweep.ui.finderMoved": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Moved 1 application to the Trash; the space comes back when the Trash is emptied."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Moved %lld applications to the Trash; the space comes back when the Trash is emptied."
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 uygulama Çöp Kutusu'na taşındı; yer, Çöp Kutusu boşaltılınca geri gelir."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld uygulama Çöp Kutusu'na taşındı; yer, Çöp Kutusu boşaltılınca geri gelir."
                }
              }
            }
          }
        }
      }
    },
    "sweep.ui.finderNotMoved": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 was not moved: %2$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld were not moved: %2$@"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 tanesi taşınmadı: %2$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld tanesi taşınmadı: %2$@"
                }
              }
            }
          }
        }
      }
    },
    "sweep.ui.hintResultFinder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter back to the menu · p ask Finder for the applications that need a password · q quit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter menüye dön · p parola isteyen uygulamalar için Finder'a sor · q çık"
          }
        }
      }
    },
    "sweep.role.group": {
      "localizations": {
