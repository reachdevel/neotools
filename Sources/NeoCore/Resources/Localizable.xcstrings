        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ için Tam Disk Erişimi zaten açık.\nÇöp Sepeti'nde %2$@ var, %3$@."
          }
        }
      }
    },
    "trash.accessSteps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS does not let a program ask for this permission; it has to be granted by hand.\n%1$@\n  1. Turn on the application your terminal runs in%2$@; add it with + if it is not in the list.\n  2. Quit it completely and open it again: the permission applies to new sessions only.\nThen neodf shows the size of the Trash."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bir programın bu izni istemesine izin vermez; elle verilmesi gerekir.\n%1$@\n  1. Terminalinizin çalıştığı uygulamayı açın%2$@; listede yoksa + ile ekleyin.\n  2. Uygulamadan tamamen çıkıp yeniden açın: izin yalnızca yeni oturumlarda geçerli olur.\nSonra neodf Çöp Sepeti'nin boyutunu gösterir."
          }
        }
      }
    },
    "trash.detected": {
      "comment": "Appended to the first step when the terminal application could be guessed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (detected: %@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " (algılanan: %@)"
          }
        }
      }
    },
