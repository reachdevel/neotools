    },
    "sweep.ui.statusGroup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are only reported: the system's folders and the hidden files of the top of the disk. Open the row to look inside."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar yalnızca bildirilir: sistemin klasörleri ve diskin üstündeki gizli dosyalar. İçine bakmak için satırı açın."
          }
        }
      }
    },
    "sweep.ui.statusNotThere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not there any more."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu artık yok."
          }
        }
      }
    },
    "sweep.cat.tool-caches.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer tool caches"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici aracı önbellekleri"
          }
        }
      }
    },
    "sweep.cat.tool-caches.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The caches of the tools you have installed (linters, build tools, test runners, terminal tools). Only the tools found on this Mac are listed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulu araçların önbellekleri (denetleyiciler, derleme araçları, test araçları, terminal araçları). Yalnızca bu Mac'te bulunan araçlar listelenir."
          }
        }
      }
    },
    "sweep.cat.tool-caches.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each tool builds its cache again the next time it runs; the first run is a little slower. Logins and settings are not in these folders."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her araç bir sonraki çalışmada önbelleğini yeniden oluşturur; ilk çalışma biraz yavaş olur. Oturum bilgileri ve ayarlar bu klasörlerde değildir."
          }
        }
      }
    },
    "sweep.cat.tool-downloads.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer tool downloads"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici aracı indirmeleri"
          }
        }
      }
    },
    "sweep.cat.tool-downloads.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packages, models and datasets that tools downloaded (Cargo, Go, Maven, PyTorch, Ollama, LM Studio, Conda...). Only the tools found on this Mac are listed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araçların indirdiği paketler, modeller ve veri kümeleri (Cargo, Go, Maven, PyTorch, Ollama, LM Studio, Conda...). Yalnızca bu Mac'te bulunan araçlar listelenir."
          }
        }
      }
    },
    "sweep.cat.tool-downloads.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are downloaded again when a project or a model needs them, which takes time and data. Nothing you wrote is in them, but a model you pulled yourself is gone until you pull it again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir proje ya da model gerektirdiğinde yeniden indirilirler; bu zaman ve veri harcar. İçlerinde yazdığınız bir şey yoktur, ama kendi çektiğiniz bir model yeniden çekene kadar gider."
          }
        }
      }
    },
    "sweep.cat.tool-versions.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed tool versions"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulu araç sürümleri"
          }
        }
      }
    },
    "sweep.cat.tool-versions.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolchains, language versions, environments, extensions and virtual machines you installed (pyenv, rustup, Conda, Android SDK, Colima...). Only the ones found on this Mac are listed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurduğunuz araç takımları, dil sürümleri, ortamlar, eklentiler ve sanal makineler (pyenv, rustup, Conda, Android SDK, Colima...). Yalnızca bu Mac'te bulunanlar listelenir."
          }
        }
      }
    },
    "sweep.cat.tool-versions.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They can be installed again, but not by themselves: the packages and settings inside an environment or a virtual machine are lost, and a project that needs the version stops building until it is installed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden kurulabilirler ama kendiliğinden değil: bir ortamın ya da sanal makinenin içindeki paketler ve ayarlar kaybolur, o sürümü isteyen bir proje yeniden kurulana kadar derlenmez."
          }
        }
      }
    },
    "sweep.brew.home.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings and data of removed packages"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırılmış paketlerin ayarları ve verileri"
          }
        }
      }
    },
    "sweep.brew.home.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders in ~/.config, Application Support and Homebrew's etc that carry the name of a Homebrew package that is not installed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulu olmayan bir Homebrew paketinin adını taşıyan ~/.config, Application Support ve Homebrew etc içindeki klasörler."
          }
        }
      }
    },
    "sweep.brew.home.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found by name only, so none is chosen: the name may belong to something else, and these folders can hold settings and data you made. Look before you choose."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca adına göre bulundu, bu yüzden hiçbiri seçili değil: ad başka bir şeye ait olabilir ve bu klasörlerde sizin yaptığınız ayarlar ve veriler olabilir. Seçmeden önce bakın."
          }
        }
      }
    },
    "sweep.brew.homeNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not installed, folder still here"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kurulu değil, klasörü duruyor"
          }
        }
      }
    },
    "sweep.ui.statusSizing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still adding this up; wait a moment, the list is moving"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hâlâ toplanıyor; biraz bekleyin, liste hareket ediyor"
          }
        }
      }
    },
    "sweep.ui.partial": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld chosen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld içinden %1$lld seçili"
          }
        }
      }
    },
    "sweep.ui.previewLoading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the folder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör okunuyor"
          }
        }
      }
    },
    "sweep.ui.previewEmpty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş"
          }
        }
      }
    },
    "sweep.ui.statusAppPane": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parts are on the right: Space chooses the application and everything it left, o opens the parts one by one"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçalar sağda: Boşluk uygulamayı ve geride bıraktığı her şeyi seçer, o parçaları tek tek seçmek için açar"
          }
        }
      }
    },
    "sweep.ui.cachedAge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sizes from %1$lld min ago · r adds them up again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "boyutlar %1$lld dk önceki · r yeniden toplar"
          }
        }
      }
    },
    "sweep.ui.andMorePlaces": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+%1$lld more places"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "+%1$lld yer daha"
          }
        }
      }
    },
    "sweep.ui.trashMode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NEO_TRASH: what you choose is moved to the Trash, not deleted (the Trash itself and programs such as brew are refused)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NEO_TRASH: seçtikleriniz silinmez, Çöp Kutusu'na taşınır (Çöp Kutusu'nun kendisi ve brew gibi programlar reddedilir)"
          }
        }
      }
    },
    "sweep.ui.resultTrash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are in the Trash: put them back from there if something is missing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Kutusu'ndalar: bir şey eksikse oradan geri koyun."
          }
        }
      }
    },
    "sweep.ui.hintReviewApps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ move · Enter open · o parts · Space select · a safe · A everything · n none · r again · f Finder · d delete · Esc back"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ git · Enter aç · o parçalar · Boşluk seç · a güvenli olanlar · A her şey · n hiçbiri · r yeniden · f Finder · d sil · Esc geri"
          }
        }
      }
    },
    "sweep.projects.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuildable folders of your projects"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projelerinizin yeniden kurulabilen klasörleri"
          }
        }
      }
    },
    "sweep.projects.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "node_modules, Python virtual environments (.venv), Rust target folders, Python caches (__pycache__, .pytest_cache, .mypy_cache) and Git LFS objects, found by walking your home folder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "node_modules, Python sanal ortamları (.venv), Rust target klasörleri, Python önbellekleri (__pycache__, .pytest_cache, .mypy_cache) ve Git LFS nesneleri; home klasörünüz gezilerek bulunur."
          }
        }
      }
    },
    "sweep.projects.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each comes back with one command (npm install, python -m venv, cargo build, running the tests, git lfs pull) but takes time and a download. A folder is found only when the file that proves it is next to it (package.json, pyproject.toml, Cargo.toml, pyvenv.cfg). Nothing is chosen at the start."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her biri tek komutla geri gelir (npm install, python -m venv, cargo build, testleri çalıştırmak, git lfs pull) ama zaman ve indirme ister. Bir klasör, onu kanıtlayan dosya yanındaysa bulunur (package.json, pyproject.toml, Cargo.toml, pyvenv.cfg). Başlangıçta hiçbiri seçili değildir."
          }
        }
      }
    },
    "sweep.projects.caches": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld cache folder"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld cache folders"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld önbellek klasörü"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld önbellek klasörü"
                }
              }
            }
          }
        }
      }
    },
    "sweep.ui.projectsSearch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "searches your home"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "home'u arar"
          }
        }
      }
    },
    "sweep.err.cannotWrite": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: cannot write %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ yazılamıyor"
          }
        }
      }
    },
    "sweep.err.exists": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ exists already; nothing was written"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ zaten var; hiçbir şey yazılmadı"
          }
        }
      }
    },
    "sweep.unsure.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure whose they are"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimin olduğundan emin olunamayanlar"
          }
        }
      }
    },
    "sweep.unsure.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders and files in your Library that the careful search does not take for leftovers: another product of an installed application's maker, a name that contains an installed application's, a name that is not an identifier (\"Spotify\", \"Adobe\"). Many are leftovers you will want to delete."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Library'nizdeki, temkinli aramanın artık saymadığı klasör ve dosyalar: kurulu bir uygulamanın üreticisinin başka bir ürünü, içinde kurulu bir uygulamanın adı geçen ad, kimlik gibi görünmeyen ad (\"Spotify\", \"Adobe\"). Çoğu silmek isteyeceğiniz artıklardır."
          }
        }
      }
    },
    "sweep.unsure.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the reason beside each one: it may belong to an application you still use (its settings or documents are in it). Nothing is chosen, and what can hold your data is marked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her birinin yanındaki nedene bakın: hâlâ kullandığınız bir uygulamaya ait olabilir (ayarları ya da belgeleri içindedir). Hiçbiri seçili değildir, veri tutabilecekler işaretlidir."
          }
        }
      }
    },
    "sweep.unsure.sameFamily": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "same maker as %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile aynı üretici"
          }
        }
      }
    },
    "sweep.unsure.knownWord": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "its name has \"%@\", an installed application"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "adında kurulu bir uygulama olan \"%@\" geçiyor"
          }
        }
      }
    },
    "sweep.unsure.notIdentifier": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not an identifier: may be anyone's"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kimlik değil: herkesin olabilir"
          }
        }
      }
    },
    "sweep.unsure.notFolder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a file where an application keeps a folder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bir uygulamanın klasör tuttuğu yerde bir dosya"
          }
        }
      }
    },
    "sweep.ui.scrollList": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ scroll · lines %1$lld-%2$lld of %3$lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ kaydır · %3$lld satırdan %1$lld-%2$lld"
          }
        }
      }
    },
    "sweep.role.appdata": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "belongs to an app or macOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bir uygulamaya ya da macOS'a ait"
          }
        }
      }
    },
    "sweep.ui.statusManaged.appdata": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This belongs to an installed app or to macOS. Remove the app from the Applications menu and its data goes with it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kurulu bir uygulamaya ya da macOS'a ait. Uygulamayı Uygulamalar menüsünden kaldırırsanız verisi de gider."
          }
        }
      }
    },
    "sweep.ui.statusRevealMany": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This opens %lld Finder windows. Press f again to open them, any other key to cancel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, %lld Finder penceresi açar. Açmak için f'ye tekrar basın, vazgeçmek için başka bir tuşa."
          }
        }
      }
    },
    "docs.error.noText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
