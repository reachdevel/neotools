{
  "sourceLanguage": "en",
  "strings": {
    "common.cannotRun": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: cannot run %2$@: %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ çalıştırılamıyor: %3$@"
          }
        }
      }
    },
    "common.fileChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a file changed while it was being read"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bir dosya okunurken değişti"
          }
        }
      }
    },
    "common.needsValue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: needs a value"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: bir değer gerekir"
          }
        }
      }
    },
    "common.notSupported": {
      "comment": "A real option of the original command that the neo tool does not have.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ is not supported here; run: %1$@ --plain %2$@ ..."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ burada desteklenmiyor; şunu çalıştırın: %1$@ --plain %2$@ ..."
          }
        }
      }
    },
    "common.unexpectedArgument": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: unexpected argument %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: beklenmeyen argüman %2$@"
          }
        }
      }
    },
    "common.unknownOption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: unknown option %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: bilinmeyen seçenek %2$@"
