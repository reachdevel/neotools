    "sweep.cat.pnpm.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects keep their own hard links, so nothing breaks; pnpm downloads again what it needs. Files that projects still link free nothing until those projects go."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeler kendi sabit bağlarını tutar, bu yüzden hiçbir şey bozulmaz; pnpm gerekeni yeniden indirir. Projelerin hâlâ bağladığı dosyalar, o projeler gidene kadar yer açmaz."
          }
        }
      }
    },
