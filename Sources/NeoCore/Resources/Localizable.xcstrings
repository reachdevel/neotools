            "value": "text recognition: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "metin tanıma: %@"
          }
        }
      }
    },
    "docs.err.delimiter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: --delimiter takes one character, or tab, comma, semicolon, pipe"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: --delimiter tek bir karakter ya da tab, comma, semicolon, pipe alır"
          }
        }
      }
    },
    "docs.err.format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: not a format I can write (%2$@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: yazabildiğim bir biçim değil (%2$@)"
          }
        }
      }
    },
    "docs.err.lang": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: not a language the text recognition knows (%2$@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: metin tanıma bu dili bilmiyor (%2$@)"
          }
        }
      }
    },
    "docs.err.mergeNone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "merge needs at least one PDF or picture"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "merge için en az bir PDF ya da resim gerekir"
          }
        }
      }
    },
    "docs.err.number": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: a whole number from %2$@ is needed"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ aralığında bir tam sayı gerekir"
          }
        }
      }
    },
    "docs.err.pages": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: not a page list (3, 3-7, 5-, 1,4,6-8)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: sayfa listesi değil (3, 3-7, 5-, 1,4,6-8)"
          }
        }
      }
    },
    "docs.err.path": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a file or a folder is needed"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bir dosya ya da klasör gerekir"
          }
        }
      }
    },
    "docs.err.readonly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ only looks: it takes none of the options that write files"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yalnızca bakar: dosya yazan seçeneklerden hiçbirini almaz"
          }
        }
      }
    },
    "docs.err.sort": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: --sort takes name, size, modified, pages or format"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: --sort name, size, modified, pages ya da format alır"
          }
        }
      }
    },
    "docs.err.splitneeds": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "split needs --pages, --each or --every"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "split için --pages, --each ya da --every gerekir"
          }
        }
      }
    },
    "docs.err.splitone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "--pages, --each and --every cannot be used together"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "--pages, --each ve --every birlikte kullanılamaz"
          }
        }
      }
    },
    "docs.err.to": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "convert needs --to"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "convert için --to gerekir"
          }
        }
      }
    },
    "docs.err.verb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: not a command (info, text, convert, merge, split, images, strip, ocr, shrink)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: böyle bir komut yok (info, text, convert, merge, split, images, strip, ocr, shrink)"
          }
        }
      }
    },
    "docs.error.appDenied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS did not let this program control %@: allow it in System Settings > Privacy & Security > Automation"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bu programın %@ uygulamasını denetlemesine izin vermedi: Sistem Ayarları > Gizlilik ve Güvenlik > Otomasyon bölümünden izin ver"
          }
        }
      }
    },
    "docs.error.appFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ could not do it: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yapamadı: %2$@"
          }
        }
      }
    },
    "docs.error.appMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not installed, and this conversion needs it (it is free in the App Store)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kurulu değil, bu dönüşüm ona ihtiyaç duyuyor (App Store'dan ücretsiz)"
          }
        }
      }
    },
    "docs.error.appTimeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ did not answer in %2$lld seconds: it may be waiting for you (a window on the screen). Open it once, answer it, and run this again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld saniyede yanıt vermedi: seni bekliyor olabilir (ekranda bir pencere). Bir kez aç, yanıtla ve bunu yeniden çalıştır"
          }
        }
      }
    },
    "docs.error.cannotWrite": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cannot write the result: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sonuç yazılamadı: %@"
          }
        }
      }
    },
    "docs.error.damaged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the file is damaged (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dosya bozuk (%@)"
          }
        }
      }
    },
    "docs.error.exists": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exists"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zaten var"
          }
        }
      }
    },
    "docs.error.noRoute": {
      "localizations": {
        "en": {
