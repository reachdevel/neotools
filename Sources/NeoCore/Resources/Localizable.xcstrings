            "value": "System and hidden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem ve gizli olanlar"
          }
        }
      }
    },
    "sweep.role.groupTitle": {
      "localizations": {
        "en": {
          "variations": {
