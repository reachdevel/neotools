    "sweep.ui.statusReportOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These need administrator rights; neosweep never deletes them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar yönetici hakkı ister; neosweep bunları asla silmez."
          }
        }
      }
    },
    "sweep.ui.statusScanning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the scan to finish."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taramanın bitmesini bekleyin."
          }
        }
      }
    },
    "sweep.ui.systemNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These belong to the system and need administrator rights. neosweep only tells you about them and never deletes them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar sisteme aittir ve yönetici hakkı ister. neosweep yalnızca bunları bildirir, asla silmez."
          }
        }
      }
    },
    "sweep.ui.typeWord": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting cannot be undone. Type \"%@\" and press Enter:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silme geri alınamaz. \"%@\" yazıp Enter'a basın:"
          }
        }
      }
    },
    "sweep.ui.waitingPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow %@ in Full Disk Access, then quit %@ and open it again: macOS reads the permission only when a program starts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasına Tam Disk Erişimi verin, sonra %@ uygulamasından çıkıp yeniden açın: macOS izni yalnızca program başlarken okur."
          }
        }
      }
    },
    "sweep.ui.warnICloud": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are in iCloud: deleting them removes them from iCloud on every device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar iCloud'da: silmek, onları her cihazdaki iCloud'dan siler."
          }
        }
      }
    },
    "sweep.ui.warnNoUndo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting is for good: nothing goes to the Trash."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silme kalıcıdır: hiçbir şey Çöp Kutusu'na gitmez."
          }
        }
      }
    },
    "sweep.ui.warnRunning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running now: %@. Quit it first (Tab asks it to quit)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an çalışıyor: %@. Önce kapatın (Tab kapanmasını ister)."
          }
        }
      }
    },
    "sweep.ui.warnState": {
      "localizations": {
        "en": {
