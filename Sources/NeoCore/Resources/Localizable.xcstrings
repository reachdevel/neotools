      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "page %1$lld is too big to draw at %2$lld dpi (lower --dpi)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. sayfa %2$lld dpi'de çizilemeyecek kadar büyük (--dpi değerini düşür)"
          }
        }
      }
    },
