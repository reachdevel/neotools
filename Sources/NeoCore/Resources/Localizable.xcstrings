    "sweep.apps.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the application and what it left in your Library. Application Support, Containers and Group Containers are listed but not chosen: they may hold your documents."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı ve Library'nizde bıraktıklarını siler. Application Support, Containers ve Group Containers listelenir ama seçili gelmez: belgelerinizi tutuyor olabilirler."
          }
        }
      }
    },
    "sweep.apps.appStore": {
      "localizations": {
        "en": {
