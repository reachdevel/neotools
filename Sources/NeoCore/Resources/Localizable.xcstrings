      }
    },
    "sweep.apps.leftovers.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data in your Library that belongs to applications that are not installed any more."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Library'nizde, artık kurulu olmayan uygulamalara ait veriler."
          }
        }
      }
    },
    "sweep.apps.leftovers.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, logs, preferences and saved state of an application that is gone are safe to delete. Application Support, Containers and Group Containers may hold your documents: they are listed, not chosen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinmiş bir uygulamanın önbellekleri, günlükleri, tercihleri ve kayıtlı durumu güvenle silinebilir. Application Support, Containers ve Group Containers belgelerinizi tutuyor olabilir: listelenir, seçili gelmez."
          }
        }
      }
    },
    "sweep.apps.includes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "includes %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "şunları içerir: %@"
          }
        }
      }
    },
    "sweep.brew.formulae.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packages you installed"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurduğunuz paketler"
          }
        }
      }
    },
    "sweep.brew.formulae.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew packages you installed yourself (brew install)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi kurduğunuz Homebrew paketleri (brew install)."
          }
        }
      }
    },
    "sweep.brew.formulae.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`brew uninstall` removes the package; Homebrew refuses when another package needs it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`brew uninstall` paketi kaldırır; başka bir paket ona ihtiyaç duyuyorsa Homebrew reddeder."
          }
        }
      }
    },
    "sweep.brew.deps.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Libraries nothing needs any more"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık kimsenin ihtiyaç duymadığı kitaplıklar"
          }
        }
      }
    },
    "sweep.brew.deps.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packages that were installed only for others, and nothing installed needs now."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca başkaları için kurulmuş ve artık kurulu hiçbir şeyin ihtiyaç duymadığı paketler."
          }
        }
      }
    },
    "sweep.brew.deps.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing them is what `brew autoremove` does."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunları kaldırmak `brew autoremove`'un yaptığı iştir."
          }
        }
      }
    },
    "sweep.brew.casks.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps installed with Homebrew"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ile kurulan uygulamalar"
          }
        }
      }
    },
    "sweep.brew.casks.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applications installed with brew install --cask."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "brew install --cask ile kurulan uygulamalar."
          }
        }
      }
    },
    "sweep.brew.casks.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`brew uninstall --cask` removes the application. Some need your password and fail here: run the command yourself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`brew uninstall --cask` uygulamayı kaldırır. Bazıları parolanızı ister ve burada başarısız olur: komutu kendiniz çalıştırın."
          }
        }
      }
    },
    "sweep.brew.old.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old versions of packages"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketlerin eski sürümleri"
          }
        }
      }
    },
    "sweep.brew.old.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Versions that Homebrew keeps next to the current one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew'un güncel sürümün yanında tuttuğu sürümler."
          }
        }
      }
    },
    "sweep.brew.old.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`brew cleanup` removes them; the current version is not touched."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`brew cleanup` bunları siler; güncel sürüme dokunulmaz."
          }
        }
      }
    },
    "sweep.brew.leftovers.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data left by removed packages"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırılmış paketlerin bıraktığı veri"
          }
        }
      }
    },
    "sweep.brew.leftovers.what": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The var folders of packages that are not installed any more (databases, state)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık kurulu olmayan paketlerin var klasörleri (veritabanları, durum)."
          }
        }
      }
    },
    "sweep.brew.leftovers.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`brew uninstall` leaves a package's data on purpose. It may be a database you want: listed, not chosen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`brew uninstall` bir paketin verisini bilerek bırakır. İstediğiniz bir veritabanı olabilir: listelenir, seçili gelmez."
          }
        }
      }
    },
