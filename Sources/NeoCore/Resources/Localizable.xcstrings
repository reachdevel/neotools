    "sweep.ui.statusSystem": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This belongs to the system; neosweep only tells you about it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sisteme aittir; neosweep yalnızca bildirir."
          }
        }
      }
    },
    "sweep.ui.statusForeign": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not yours (another user's, or a Time Machine disk)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sizin değil (başka bir kullanıcının ya da bir Time Machine diskinin)."
          }
        }
      }
    },
    "sweep.ui.statusKeep": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder stays as it is: open it and choose what is inside."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör olduğu gibi kalır: içine girip içindekileri seçin."
          }
        }
      }
    },
    "sweep.ui.statusManaged.applications": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applications are removed from the Applications menu, together with what they left."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar, bıraktıklarıyla birlikte Uygulamalar menüsünden kaldırılır."
          }
        }
      }
    },
    "sweep.ui.statusManaged.homebrew": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew is managed from the Homebrew menu: it knows what depends on what."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew, Homebrew menüsünden yönetilir: neyin neye bağlı olduğunu o bilir."
          }
        }
      }
    },
    "sweep.ui.statusManaged.trash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Trash is emptied from Disk clean."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Kutusu Disk temizliğinden boşaltılır."
          }
        }
      }
    },
    "sweep.ui.overviewEmpty": {
      "localizations": {
