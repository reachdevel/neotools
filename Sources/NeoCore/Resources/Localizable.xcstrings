    "sweep.cat.app-caches.why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applications build their caches again when they need them. Quit an application before its cache goes; Apple's own (com.apple.*) are shown but not selected."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar önbelleklerini gerektiğinde yeniden oluşturur. Önbelleği silinecek uygulamayı önce kapatın; Apple'ın kendi önbellekleri (com.apple.*) gösterilir ama seçili gelmez."
          }
        }
      }
    },
